<div class="crux__wrapper">
    <div class="crux__tray">
        <div class="crux__panel-backdrop"></div>
        <div class="crux__container {{iconSize}}">
            <div class="crux__actors">
                {{#if activePanel.partial}}
                    {{> (lookup activePanel "partial")}}
                {{else}}
                    <div class="crux__tab-panel crux__tab-panel--blank" data-crux-tab-panel="{{activeTab}}">
                        {{> crux-empty-tray}}
                    </div>
                {{/if}}
            </div>
        </div>
    </div>
    {{> crux-tab-rail}}
</div>
