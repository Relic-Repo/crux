<div class="crux__wrapper">
    <div class="crux__tray">
        <div class="crux__panel-backdrop"></div>
        <div class="crux__container {{iconSize}}">
            <div class="crux__actors">
            {{#*inline "item-list"}}
                <ul class="crux__items">
                    {{#each this}}
                        <li class="crux__item item" data-item-uuid="{{item.uuid}}" {{#if activityId}}data-activity-id="{{activityId}}"{{/if}}>
                            <div class="item-name rollable flexrow">
                                <div class="item-image" data-action="activateItem" style="background-image: url('{{item.img}}')">
                                    <i class="fa fa-dice-d20"></i>
                                </div>
                                <h4 data-action="toggleItemSummary">
                                    {{#if activityName}}
                                        {{activityName}} ({{item.name}})
                                    {{else}}
                                        {{item.name}}
                                    {{/if}}
                                </h4>
                                
                                {{#if (or 
                                  (and (eq item.type "consumable") (eq item.system.type.value "ammo") @root.showQuantity)
                                  (and (has item.system.properties "thr") @root.showQuantity)
                                  (and item.system.quantity @root.showQuantity))}}
                                <div class="crux-spinner q-spinner" data-action="toggleQSpinner" data-edit="false" data-item-uuid="{{item.uuid}}">
                                    <div class="display-mode">
                                        <span class="letter">x</span>
                                        <span class="value">{{item.system.quantity}}</span>
                                    </div>
                                    <div class="edit-mode hidden">
                                        <input type="number" min="0" value="{{item.system.quantity}}">
                                    </div>
                                </div>
                                {{/if}}
                                
                                {{#if uses}}
                                    {{#if (and uses.maximum (gt uses.maximum 0) @root.showUses)}}
                                    <div class="crux-spinner u-spinner" data-action="toggleUSpinner" data-edit="false" data-item-uuid="{{item.uuid}}">
                                        <div class="display-mode">
                                            <span class="letter"> </span>
                                            <span class="value">{{uses.available}}/{{uses.maximum}}</span>
                                        </div>
                                        <div class="edit-mode hidden">
                                            <input type="number" min="0" max="{{uses.maximum}}" value="{{uses.available}}">
                                        </div>
                                    </div>
                                    {{/if}}
                                {{/if}}

                                {{#if (and (eq item.type "spell") (has item.system.properties "ritual"))}}
                                    <div class="ritual flag" title="{{localize "crux.flag.ritual-title"}}">{{localize "crux.flag.ritual"}}</div>
                                {{/if}}

                                {{#if (eq (getActivationType item) "bonus")}}
                                    <div class="bonus flag" title="{{localize "crux.flag.bonus-title"}}">{{localize "crux.flag.bonus"}}</div>
                                {{/if}}
                                {{#if (eq (getActivationType item) "reaction")}}
                                    <div class="reaction flag" title="{{localize "crux.flag.reaction-title"}}">{{localize "crux.flag.reaction"}}</div>
                                {{/if}}
                                {{#if (eq (getActivationType item) "legendary")}}
                                    <div class="legendary flag" title="{{localize "crux.flag.legendary-title"}}">{{localize "crux.flag.legendary"}}</div>
                                {{/if}}

                                {{#if (and (eq item.type "spell") (has item.system.properties "concentration"))}}
                                    <div class="concentration flag" title="{{localize "crux.flag.concentration-title"}}">{{localize "crux.flag.concentration"}}</div>
                                {{/if}}

                                {{#if (and (hasRechargeRecovery item) (hasRemainingUses item))}}
                                <div class="flag"><i class="fas fa-bolt"></i></div>
                                {{/if}}
                                {{#if (and (hasRechargeRecovery item) (not (hasRemainingUses item)))}}
                                <div class="flag"><a data-action="rechargeItem"><i class="fas fa-dice-six"></i> {{getRechargeFormula item}}+</a></div>
                                {{/if}}

                                {{#if (and (eq (getSpellMethod item) "prepared") (not (getSpellPrepared item)) (ne item.system.level 0))}}
                                    <div class="unprepared flag" title="{{localize "crux.flag.unprepared-title"}}">{{localize "crux.flag.unprepared"}}</div>
                                {{/if}}
                            </div>
                        </li>
                    {{/each}}
                </ul>
            {{/inline}}

            {{#*inline "item-category"}}
                <div class="crux__section">
                    <h2 class="crux__section-header" data-action="toggleSection">
                        <span>{{localize title}}</span>
                        <i class="fas fa-caret-up"></i>
                    </h2>
                    <div class="crux__section-content">
                        {{#with items}}
                            {{> item-list }}
                        {{/with}}
                        {{#each groups as |group groupName|}}
                            {{> item-group groupName=groupName showSpellDots=../showSpellDots showSpellFractions=../showSpellFractions }}
                        {{/each}}
                    </div>
                </div>
            {{/inline}}

            {{#*inline "item-group"}}
                {{#if (or items.length (and uses.maximum showSpellDots))}}
                    <div class="crux__group">
                        <div class="crux__group-header flexrow" data-action="toggleGroup">
                            <h3>
                                <span>{{localize title}}</span>
                                {{#if (and uses showSpellDots)}}
                                    <div class="group-dots" data-group-name="{{groupName}}">
                                        {{#each (cruxSlots uses.available uses.maximum) as |available slotNumber|}}
                                            <div class="dot {{#unless available}}empty{{/unless}}" data-slot="{{slotNumber}}"></div>
                                        {{/each}}
                                    </div>
                                {{/if}}
                            </h3>
                            {{#if uses}}
                                {{#if showSpellFractions}}
                                    <div class="group-uses">{{uses.available}}/{{uses.maximum}}</div>
                                {{/if}}
                            {{/if}}
                            <i class="fas fa-caret-up"></i>
                        </div>
                        <div class="crux__group-content">
                            {{#with items}}
                                {{> item-list }}
                            {{/with}}
                        </div>
                    </div>
                {{/if}}
            {{/inline}}

            {{#*inline "skill-container"}}
                <div class="crux__skill-container {{skillMode}} {{#if showSkills}}is-open{{/if}}">
                    <a class="crux__skill-header" data-action="toggleSkills">
                        <span class="crux__skill-header-label">Skills</span>
                        <i class="fas fa-caret-up"></i>
                    </a>
                    <div class="crux__skills">
                        {{#each actor.system.skills as |skill s|}}
                            <div class="crux__skill-row {{#if (gte skill.proficient 1)}}proficient{{/if}}">
                                <div class="flex0" data-action="rollSkill" data-skill="{{s}}">
                                    {{#if (eq skill.proficient 0)}}<i class="far fa-circle"></i>{{/if}}
                                    {{#if (eq skill.proficient 0.5)}}<i class="fas fa-adjust"></i>{{/if}}
                                    {{#if (eq skill.proficient 1)}}<i class="fas fa-check"></i>{{/if}}
                                    {{#if (eq skill.proficient 2)}}<i class="fas fa-check-double"></i>{{/if}}
                                </div>
                                <div class="crux__skill-label" data-action="rollSkill" data-skill="{{s}}">
                                    {{#with (lookup ../skills s)}}
                                        <span>{{label}}</span>
                                    {{/with}}
                                </div>
                                <div class="crux__skill-bonus" data-action="rollSkill" data-skill="{{s}}">
                                    {{numberFormat total decimals=0 sign=true}}
                                </div>
                                <div class="crux__skill-passive" data-action="rollSkill" data-skill="{{s}}">
                                    ({{add total 10}})
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            {{/inline}}

            {{#if (eq activeTab "actions")}}
                <div class="crux__tab-panel crux__tab-panel--actions" data-crux-tab-panel="actions">
                    {{#each actors as |actor|}}
                        <div class="crux__actor" data-actor-uuid="{{actor.actor.uuid}}">
                            <div class="crux__top-section">
                                <h1 class="crux__action-actor-name">
                                    <a class="crux__actor-name">{{name}}</a>
                                </h1>
                                <div class="crux__action-actor-body">
                                    <div class="crux__portrait" title="{{#unless (gt actor.actor.system.attributes.hp.value 0)}}Roll Death Saving Throw{{else}}Flip actor card{{/unless}}">
                                        <div class="crux__portrait-inner">
                                            <div class="crux__portrait-front {{#if (gt (calculateHealthOverlay actor.actor.system.attributes.hp.value actor.actor.system.attributes.hp.max) 50)}}breathe{{/if}}">
                                                {{#if (lookup @root.settings "health-overlay-enabled")}}
                                                    <div class="crux__portrait-health-overlay {{#if (eq (lookup @root.settings "health-overlay-direction") "up")}}health-overlay-up{{else}}health-overlay-down{{/if}}"
                                                        style="height: {{calculateHealthOverlay actor.actor.system.attributes.hp.value actor.actor.system.attributes.hp.max}}%"
                                                        data-current-hp="{{actor.actor.system.attributes.hp.value}}"
                                                        data-max-hp="{{actor.actor.system.attributes.hp.max}}">
                                                    </div>
                                                {{/if}}

                                                {{#unless (gt actor.actor.system.attributes.hp.value 0)}}
                                                    <div class="crux__dead-icon-container">
                                                        <img src="modules/crux/img/dead.svg" alt="Dead Character" class="crux__dead-icon">
                                                    </div>
                                                {{else}}
                                                    <img src="{{actor.actor.img}}" alt="Character Portrait">
                                                {{/unless}}
                                            </div>
                                            <div class="crux__portrait-back">
                                                <div class="crux__stat-row">
                                                    <span class="crux__svg-icon crux__svg-icon--shield" role="img" aria-label="AC"></span>
                                                    <span>AC: {{actor.actor.system.attributes.ac.value}}</span>
                                                </div>
                                                <div class="crux__stat-row">
                                                    <span class="crux__svg-icon crux__svg-icon--hearts" role="img" aria-label="HP"></span>
                                                    <span>HP: {{actor.actor.system.attributes.hp.value}}/{{actor.actor.system.attributes.hp.max}}</span>
                                                </div>
                                                <div class="crux__stat-row">
                                                    <span class="crux__svg-icon crux__svg-icon--eye-target" role="img" aria-label="Passive Perception"></span>
                                                    <span>P. Perc.: {{add actor.actor.system.skills.prc.total 10}}</span>
                                                </div>

                                                <div class="crux__rest-buttons">
                                                    <a class="crux__rest-button" data-action="shortRest" title="{{localize "crux.short-rest"}}">
                                                        <span class="crux__svg-icon crux__svg-icon--knife-fork" role="img" aria-label="{{localize "crux.short-rest"}}"></span>
                                                    </a>
                                                    <a class="crux__rest-button" data-action="longRest" title="{{localize "crux.long-rest"}}">
                                                        <span class="crux__svg-icon crux__svg-icon--camping-tent" role="img" aria-label="{{localize "crux.long-rest"}}"></span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="crux__info-section">
                                        <div class="crux__abilities">
                                            {{#each abilities as |details abbr|}}
                                                <a class="crux__ability" data-action="rollAbility" data-ability="{{abbr}}" title="{{details.label}} {{details.value}} ({{numberFormat details.mod decimals=0 sign=true}} / {{#if details.save}}{{numberFormat details.save decimals=0 sign=true}}{{else}}+0{{/if}})">
                                                {{abbr}}
                                                </a>
                                            {{/each}}
                                        </div>
                                    </div>
                                    <div class="crux__action-stat-column">
                                        <button type="button"
                                                class="crux__action-stat-tab"
                                                data-action="rollInitiative"
                                                title="Roll Initiative">
                                            <strong>{{numberFormat actorStats.initiative decimals=0 sign=true}}</strong>
                                            <span>INIT</span>
                                        </button>
                                        <div class="crux__action-stat-tab">
                                            <strong>{{actorStats.speed}}</strong>
                                            <span>SPD</span>
                                        </div>
                                        <div class="crux__action-stat-tab">
                                            <strong>{{numberFormat actorStats.proficiency decimals=0 sign=true}}</strong>
                                            <span>PROF</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="crux__combat-actions">
                                {{#if needsInitiative}}
                                    <a class="crux__initiative flexrow" data-action="rollInitiative">
                                        <span class="flex0 crux__svg-icon crux__svg-icon--sword crux__initiative-icon" role="img" aria-label="{{localize "crux.roll-initiative"}}"></span>
                                        <div>{{localize "crux.roll-initiative"}}</div>
                                    </a>
                                {{/if}}
                                {{#if isCurrentTurn}}
                                    <a class="crux__end-turn-button flexrow" data-action="endTurn">
                                        <span class="flex0 crux__svg-icon crux__svg-icon--hourglass" role="img" aria-label="{{localize "crux.end-turn"}}"></span>
                                        <div>{{localize "crux.end-turn"}}</div>
                                    </a>
                                {{/if}}
                            </div>

                    {{#if (eq skillMode "dropdown")}}
                        {{> skill-container}}
                    {{/if}}

                    <div class="crux__actions-container">
                        <div class="crux__action-buttons">
                            <a class="crux__action-button" data-action="activateItem" data-action-id="dash" title="{{localize "crux.action.dash"}}">
                                <span class="crux__svg-icon crux__svg-icon--dash" role="img" aria-label="Dash"></span>
                            </a>
                            <a class="crux__action-button" data-action="activateItem" data-action-id="disengage" title="{{localize "crux.action.disengage"}}">
                                <span class="crux__svg-icon crux__svg-icon--disengage" role="img" aria-label="Disengage"></span>
                            </a>
                            <a class="crux__action-button" data-action="activateItem" data-action-id="dodge" title="{{localize "crux.action.dodge"}}">
                                <span class="crux__svg-icon crux__svg-icon--dodge" role="img" aria-label="Dodge"></span>
                            </a>
                            <a class="crux__action-button" data-action="activateItem" data-action-id="grapple" title="{{localize "crux.action.grapple"}}">
                                <span class="crux__svg-icon crux__svg-icon--grapple" role="img" aria-label="Grapple"></span>
                            </a>
                            <a class="crux__action-button" data-action="activateItem" data-action-id="hide" title="{{localize "crux.action.hide"}}">
                                <span class="crux__svg-icon crux__svg-icon--hide" role="img" aria-label="Hide"></span>
                            </a>
                            <a class="crux__action-button" data-action="activateItem" data-action-id="shove" title="{{localize "crux.action.shove"}}">
                                <span class="crux__svg-icon crux__svg-icon--shove" role="img" aria-label="Shove"></span>
                            </a>
                        </div>
                    </div>

                    <div class="crux__utility-buttons crux__token-controls">
                        <div class="crux__utility-button crux__open-token">
                            <a class="crux__open-token-button" data-action="openToken" title="{{localize "crux.open-token"}}">
                                <span class="crux__svg-icon crux__svg-icon--character" role="img" aria-label="{{localize "crux.open-token"}}"></span>
                                <span class="button-text">{{localize "crux.open-token"}}</span>
                            </a>
                        </div>

                        <div class="crux__utility-button crux__toggle-target">
                            <a class="crux__toggle-target-button" data-action="toggleTarget" title="{{localize 'crux.toggle-target'}}">
                                <span class="crux__svg-icon crux__svg-icon--target" role="img" aria-label="{{localize "crux.toggle-target"}}"></span>
                                <span class="button-text">{{localize "crux.toggle-target"}}</span>
                            </a>
                        </div>

                        <div class="crux__utility-button crux__status-effects">
                            <a class="crux__status-effects-button" data-action="openEffects" title="{{localize "crux.status-effects"}}">
                                <span class="crux__svg-icon crux__svg-icon--aura" role="img" aria-label="Status Effects"></span>
                                <span class="button-text">{{localize "crux.status-effects"}}</span>
                            </a>
                        </div>
                    </div>

                    <div class="crux__utility-buttons">
                        <div class="crux__utility-button crux__add-to-combat">
                            <a class="crux__add-to-combat-button" data-action="addToCombat" title="{{localize "crux.add-to-combat"}}">
                                <span class="crux__svg-icon crux__svg-icon--sword" role="img" aria-label="{{localize "crux.add-to-combat"}}"></span>
                                <span class="button-text">{{localize "crux.add-to-combat"}}</span>
                            </a>
                        </div>

                        <div class="crux__utility-button crux__set-elevation">
                            <a class="crux__set-elevation-button" data-action="setElevation" title="{{localize "crux.set-elevation"}}">
                                <span class="crux__svg-icon crux__svg-icon--lift" role="img" aria-label="{{localize "crux.set-elevation"}}"></span>
                                <span class="button-text">{{localize "crux.set-elevation"}}</span>
                            </a>
                        </div>

                        <div class="crux__utility-button crux__expand-collapse">
                            <a class="crux__expand-collapse-button" data-action="expandCollapse" title="Expand/Collapse All">
                                <span class="crux__svg-icon crux__svg-icon--back-forth" role="img" aria-label="Expand/Collapse All"></span>
                                <span class="button-text">Expand/Collapse All</span>
                            </a>
                        </div>
                    </div>

                    {{#with sections}}
                        {{#with favorites}}
                            {{> item-category}}
                        {{/with}}
                        {{#with equipped}}
                            {{> item-category}}
                        {{/with}}
                        {{#with feature}}
                            {{> item-category}}
                        {{/with}}
                        {{#with spell}}
                            {{> item-category showSpellDots=../../../showSpellDots showSpellFractions=../../../showSpellFractions}}
                        {{/with}}
                        {{#with inventory}}
                            {{> item-category}}
                        {{/with}}
                        {{#with passive}}
                            {{> item-category}}
                        {{/with}}
                    {{/with}}

                            {{#if (eq skillMode "append")}}
                                {{> skill-container}}
                            {{/if}}
                        </div>
                    {{/each}}

                    {{#unless actors.length}}
                        <div class="crux__empty-tray">
                            <i class="{{lookup @root.settings "empty-tray-icon"}}"></i>
                        </div>
                    {{/unless}}
                </div>
            {{else if (eq activeTab "actor")}}
                <div class="crux__tab-panel crux__tab-panel--actor" data-crux-tab-panel="actor">
                    {{#each actors as |actor|}}
                        <section class="crux__actor-tab crux__actor" data-actor-uuid="{{actor.actor.uuid}}">
                            <h1 class="crux__actor-tab-name">
                                <a class="crux__actor-name">{{name}}</a>
                            </h1>
                            <div class="crux__actor-hero">
                                <div class="crux__actor-portrait-wrap">
                                    <img class="crux__actor-portrait" src="{{actor.actor.img}}" alt="{{name}}">
                                    <div class="crux__actor-ability-tabs">
                                        {{#each abilities as |details abbr|}}
                                            <button type="button"
                                                    class="crux__actor-ability-tab"
                                                    data-action="rollAbility"
                                                    data-ability="{{abbr}}"
                                                    title="{{details.label}} {{details.value}} ({{numberFormat details.mod decimals=0 sign=true}})">
                                                <span class="crux__actor-ability-abbr">{{uppercase abbr}}:</span>
                                                <span class="crux__actor-ability-score">{{details.value}} / {{numberFormat details.mod decimals=0 sign=true}}</span>
                                            </button>
                                        {{/each}}
                                    </div>
                                </div>
                                {{#unless isNpc}}
                                    <div class="crux__actor-exhaustion">
                                        {{#each (cruxSlots actorStats.exhaustion 6) as |active|}}
                                            <span class="crux__actor-exhaustion-dot {{#unless active}}is-empty{{/unless}}"></span>
                                        {{/each}}
                                    </div>
                                    <div class="crux__actor-death-saves" title="Death Saves">
                                        <div class="crux__actor-death-row crux__actor-death-row--success">
                                            {{#each (cruxSlots actorStats.death.success 3) as |active|}}
                                                <span class="crux__actor-death-dot {{#unless active}}is-empty{{/unless}}"></span>
                                            {{/each}}
                                        </div>
                                        <div class="crux__actor-death-row crux__actor-death-row--failure">
                                            {{#each (cruxSlots actorStats.death.failure 3) as |active|}}
                                                <span class="crux__actor-death-dot {{#unless active}}is-empty{{/unless}}"></span>
                                            {{/each}}
                                        </div>
                                    </div>
                                {{/unless}}
                                <div class="crux__actor-ac-badge">{{actorStats.ac}}</div>
                            </div>
                            <div class="crux__actor-stat-row">
                                <button type="button"
                                        class="crux__actor-stat-tab"
                                        data-action="rollInitiative"
                                        title="Roll Initiative">
                                    <strong>{{numberFormat actorStats.initiative decimals=0 sign=true}}</strong>
                                    <span>INIT</span>
                                </button>
                                <div class="crux__actor-stat-tab">
                                    <strong>{{actorStats.speed}}</strong>
                                    <span>SPD</span>
                                </div>
                                <div class="crux__actor-stat-tab">
                                    <strong>{{numberFormat actorStats.proficiency decimals=0 sign=true}}</strong>
                                    <span>PROF</span>
                                </div>
                            </div>
                            <div class="crux__actor-vitals">
                                <div class="crux__actor-vital">
                                    <span>Hit Points</span>
                                    <div class="crux__actor-bar crux__actor-bar--hp {{#if actorStats.hp.temp}}has-temp-hp{{/if}}">
                                        <div class="crux__actor-bar-main" data-action="toggleHpEditor" data-hp-field="value" data-edit="false">
                                            <div class="crux__actor-bar-fill crux__actor-bar-fill--hp" style="width: {{actorStats.hp.pct}}%"></div>
                                            <strong class="display-mode">{{actorStats.hp.value}} / {{actorStats.hp.max}}</strong>
                                            <div class="edit-mode hidden">
                                                <input type="number" min="0" max="{{actorStats.hp.max}}" value="{{actorStats.hp.value}}">
                                            </div>
                                        </div>
                                        <div class="crux__actor-temp-hp" data-action="toggleHpEditor" data-hp-field="temp" data-edit="false">
                                            <span class="display-mode">
                                                {{#if actorStats.hp.temp}}
                                                    {{actorStats.hp.temp}}
                                                {{else}}
                                                    TMP
                                                {{/if}}
                                            </span>
                                            <div class="edit-mode hidden">
                                                <input type="number" min="0" value="{{actorStats.hp.temp}}">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="crux__actor-vital">
                                    <span>Hit Dice</span>
                                    <div class="crux__actor-bar crux__actor-bar--hd">
                                        <div class="crux__actor-bar-fill crux__actor-bar-fill--hd" style="width: {{actorStats.hitDice.pct}}%"></div>
                                        <strong>{{actorStats.hitDice.value}} / {{actorStats.hitDice.max}}</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="crux__actor-saves">
                                <h2><span class="crux__svg-icon crux__svg-icon--shield" role="img" aria-label="Saving Throws"></span> Saving Throws</h2>
                                <div class="crux__actor-save-grid">
                                    {{#each abilities as |details abbr|}}
                                        <button type="button"
                                                class="crux__actor-save"
                                                data-action="rollSave"
                                                data-ability="{{abbr}}">
                                            <span>{{details.label}}</span>
                                            <strong>{{numberFormat details.save decimals=0 sign=true}}</strong>
                                        </button>
                                    {{/each}}
                                </div>
                            </div>
                            <div class="crux__actor-identity-cards">
                                {{#with actorIdentity.creatureType}}
                                    {{#if uuid}}
                                        <button type="button"
                                                class="crux__actor-identity-card"
                                                data-action="openIdentityItem"
                                                data-item-uuid="{{uuid}}"
                                                title="{{label}}">
                                            <img src="{{img}}" alt="">
                                            <span>
                                                <strong>{{label}}</strong>
                                                {{#if subtitle}}<em>{{subtitle}}</em>{{/if}}
                                            </span>
                                        </button>
                                    {{else}}
                                        <div class="crux__actor-identity-card crux__actor-identity-card--static" title="{{label}}">
                                            <img src="{{img}}" alt="">
                                            <span>
                                                <strong>{{label}}</strong>
                                                {{#if subtitle}}<em>{{subtitle}}</em>{{/if}}
                                            </span>
                                        </div>
                                    {{/if}}
                                {{/with}}
                                {{#with actorIdentity.species}}
                                    {{#if uuid}}
                                        <button type="button"
                                                class="crux__actor-identity-card"
                                                data-action="openIdentityItem"
                                                data-item-uuid="{{uuid}}"
                                                title="{{label}}">
                                            <img src="{{img}}" alt="">
                                            <span>
                                                <strong>{{label}}</strong>
                                                {{#if subtitle}}<em>{{subtitle}}</em>{{/if}}
                                            </span>
                                        </button>
                                    {{else}}
                                        <div class="crux__actor-identity-card crux__actor-identity-card--static" title="{{label}}">
                                            <img src="{{img}}" alt="">
                                            <span>
                                                <strong>{{label}}</strong>
                                                {{#if subtitle}}<em>{{subtitle}}</em>{{/if}}
                                            </span>
                                        </div>
                                    {{/if}}
                                {{/with}}
                                {{#with actorIdentity.background}}
                                    {{#if uuid}}
                                        <button type="button"
                                                class="crux__actor-identity-card"
                                                data-action="openIdentityItem"
                                                data-item-uuid="{{uuid}}"
                                                title="{{label}}">
                                            <img src="{{img}}" alt="">
                                            <span>
                                                <strong>{{label}}</strong>
                                                {{#if subtitle}}<em>{{subtitle}}</em>{{/if}}
                                            </span>
                                        </button>
                                    {{else}}
                                        <div class="crux__actor-identity-card crux__actor-identity-card--static" title="{{label}}">
                                            <img src="{{img}}" alt="">
                                            <span>
                                                <strong>{{label}}</strong>
                                                {{#if subtitle}}<em>{{subtitle}}</em>{{/if}}
                                            </span>
                                        </div>
                                    {{/if}}
                                {{/with}}
                            </div>
                            {{#if actorTraits.length}}
                                <div class="crux__actor-traits">
                                    {{#each actorTraits as |category|}}
                                        <section class="crux__actor-trait-category crux__actor-trait-category--{{category.id}}">
                                            <h2><i class="{{category.icon}}"></i> {{category.label}}</h2>
                                            <div class="crux__actor-trait-tags">
                                                {{#each category.tags as |tag|}}
                                                    <span class="crux__actor-trait-tag">
                                                        <strong>{{tag.label}}</strong>
                                                        {{#if tag.value}}<em>{{tag.value}}</em>{{/if}}
                                                    </span>
                                                {{/each}}
                                            </div>
                                        </section>
                                    {{/each}}
                                </div>
                            {{/if}}
                        </section>
                    {{/each}}

                    {{#unless actors.length}}
                        <div class="crux__empty-tray">
                            <i class="{{lookup @root.settings "empty-tray-icon"}}"></i>
                        </div>
                    {{/unless}}
                </div>
            {{else}}
                <div class="crux__tab-panel crux__tab-panel--blank" data-crux-tab-panel="{{activeTab}}">
                    <div class="crux__empty-tray">
                        <i class="{{lookup @root.settings "empty-tray-icon"}}"></i>
                    </div>
                </div>
            {{/if}}
            </div>
        </div>
    </div>
    <nav class="crux__tab-rail" aria-label="Crux panel tabs">
        {{#each tabs as |tab|}}
            <button type="button"
                    class="crux__tab {{#if (eq @root.activeTab tab.id)}}is-active{{/if}}"
                    data-action="toggleTab"
                    data-tab="{{tab.id}}"
                    title="{{tab.label}}"
                    aria-label="{{tab.label}}"></button>
        {{/each}}
    </nav>
</div>
