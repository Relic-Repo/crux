<div class="crux__utility-buttons crux__token-controls">
    <div class="crux__utility-button crux__open-token">
        <a class="crux__open-token-button" data-action="openToken" title="{{localize "crux.open-token"}}">
            <span class="crux__svg-icon crux__svg-icon--character" role="img" aria-label="{{localize "crux.open-token"}}"></span>
            <span class="button-text">{{localize "crux.open-token"}}</span>
        </a>
    </div>

    <div class="crux__utility-button crux__toggle-target">
        <a class="crux__toggle-target-button" data-action="toggleTarget" title="{{localize 'crux.toggle-target'}}">
            <span class="crux__svg-icon crux__svg-icon--target" role="img" aria-label="{{localize "crux.toggle-target"}}"></span>
            <span class="button-text">{{localize "crux.toggle-target"}}</span>
        </a>
    </div>

    <div class="crux__utility-button crux__status-effects">
        <a class="crux__status-effects-button" data-action="openEffects" title="{{localize "crux.status-effects"}}">
            <span class="crux__svg-icon crux__svg-icon--aura" role="img" aria-label="{{localize "crux.status-effects"}}"></span>
            <span class="button-text">{{localize "crux.status-effects"}}</span>
        </a>
    </div>
</div>
