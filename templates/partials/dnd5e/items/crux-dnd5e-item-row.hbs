<li class="crux__item item" data-item-uuid="{{item.uuid}}" {{#if activityId}}data-activity-id="{{activityId}}"{{/if}}>
    <div class="item-name rollable flexrow">
        <div class="item-image" data-action="activateItem" draggable="false" style="background-image: url('{{item.img}}')">
            <i class="fa fa-dice-d20"></i>
        </div>
        <h4 data-action="toggleItemSummary">
            {{#if activityName}}
                {{activityName}} ({{item.name}})
            {{else}}
                {{item.name}}
            {{/if}}
        </h4>

        {{> crux-dnd5e-item-quantity-spinner}}
        {{> crux-dnd5e-item-uses-spinner}}
        {{> crux-dnd5e-item-flags}}
    </div>
</li>
